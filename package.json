{
  "name": "adaptab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebMCP for every tab.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run --root .",
    "test:watch": "vitest --root .",
    "typecheck": "tsc -b",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.11",
    "@netlify/functions": "^5.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
